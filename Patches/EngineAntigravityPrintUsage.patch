+    /// Parses `agy -p /usage --output-format json`. agy 1.2.2+ rejects token-less local server requests,
+    /// so this print report is the only local CLI source CodexBar can read on current releases.
+    static func parseCLIUsageReport(_ data: Data) throws -> AntigravityStatusSnapshot {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        let report = try decoder.decode(QuotaSummaryCLIReport.self, from: data)
+        guard report.status == "SUCCESS", report.command?.name == "usage", let payload = report.command?.data else {
+            throw AntigravityStatusProbeError.parseFailed("Unsuccessful CLI usage report")
+        }
+        let groups = payload.groups.compactMap(self.quotaSummaryGroup(from:))
+        guard groups.contains(where: { group in group.buckets.contains { $0.remainingFraction != nil } }) else {
+            throw AntigravityStatusProbeError.parseFailed("CLI usage report has no known quota")
+        }
+        return AntigravityStatusSnapshot(
+            quotaSummary: AntigravityQuotaSummary(
+                description: payload.description,
+                groups: groups),
+            accountEmail: nil,
+            accountPlan: nil,
+            source: .local)
+    }
